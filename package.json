{
  "name": "system-monitor",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun --watch apps/api/src/index.ts",
    "dev:worker": "bun --watch apps/worker/src/index.ts",
    "dev:agent": "bun --watch apps/agent/src/index.ts",
    "dev:dashboard": "bun run --cwd apps/dashboard dev",
    "start:api": "bun apps/api/src/index.ts",
    "start:worker": "bun apps/worker/src/index.ts",
    "start:agent": "bun apps/agent/src/index.ts",
    "db:generate": "cd packages/database && drizzle-kit generate",
    "db:migrate": "bun packages/database/src/migrate.ts",
    "db:seed": "bun packages/database/src/seed.ts",
    "user:create": "bun scripts/create-user.ts",
    "host:register": "bun scripts/register-host.ts",
    "simulate": "bun scripts/simulate.ts",
    "build:agent": "bun build apps/agent/src/index.ts --compile --minify --target=bun-linux-x64 --outfile dist/system-monitor-agent-linux-x64 && bun build apps/agent/src/index.ts --compile --minify --target=bun-linux-arm64 --outfile dist/system-monitor-agent-linux-arm64",
    "build:dashboard": "bun run --cwd apps/dashboard build",
    "build": "bun run build:dashboard && bun run build:agent",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/dashboard/tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.3.14",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@system-monitor/config": "workspace:*",
    "@system-monitor/database": "workspace:*",
    "@system-monitor/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "zod": "4.6.7"
  }
}
