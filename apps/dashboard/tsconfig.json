{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": [],
    // The package entry of @system-monitor/shared also re-exports server-only modules (logger, zod
    // schemas). The dashboard resolves the name to a browser-safe re-export of the pure modules;
    // Bun's bundler honours the same mapping, so zod never ends up in the bundle.
    "paths": { "@system-monitor/shared": ["./src/shared.ts"] }
  },
  "include": ["src"]
}
