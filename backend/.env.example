# Monitoring VM configuration – copy to .env (chmod 600). Placeholders only; never commit .env.
# Generate secrets with: openssl rand -hex 32   (hex keeps them URL-safe for DATABASE_URL)

# ---- Monitoring database (dedicated; never the production database)
POSTGRES_USER=monitor_owner
POSTGRES_PASSWORD=CHANGE_ME_owner_password_hex
POSTGRES_DB=system_monitor
APP_DB_PASSWORD=CHANGE_ME_app_password_hex
DATABASE_POOL_MAX=10

# ---- API
LOG_LEVEL=info
PUBLIC_ORIGIN=https://monitor.example.com
TRUST_PROXY=true
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
MAX_BODY_BYTES=262144
MAX_SNAPSHOT_AGE_SECONDS=900
MAX_CLOCK_SKEW_SECONDS=60
HEARTBEAT_OFFLINE_SECONDS=180

# ---- Worker
EVALUATION_INTERVAL_SECONDS=15
STALE_AFTER_SECONDS=120
AGENT_INTERVAL_SECONDS=30
METRICS_RETENTION_DAYS=30
INCIDENT_RETENTION_DAYS=365
NOTIFICATION_RETENTION_DAYS=90
ALERT_TIMEZONE=Asia/Kolkata
# External dead man's switch (e.g. healthchecks.io); pinged once a minute while healthy.
DEADMAN_PING_URL=

# ---- WhatsApp Business Platform Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Comma-separated E.164 numbers; also the allow-list for test messages.
WHATSAPP_RECIPIENT=+910000000000
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=system_alert
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TIMEOUT_MS=10000
WHATSAPP_MAX_ATTEMPTS=10
# Delivery-status webhook (Meta app → Webhooks)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_random_string
WHATSAPP_APP_SECRET=

# Host port the API is published on (loopback only); match proxy_pass in the Nginx site config.
API_PUBLISH_PORT=3000
