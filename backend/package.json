{
  "name": "system-monitor-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "bun --watch src/api/index.ts",
    "dev:worker": "bun --watch src/worker/index.ts",
    "start:api": "bun src/api/index.ts",
    "start:worker": "bun src/worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:seed": "bun src/db/seed.ts",
    "user:create": "bun scripts/create-user.ts",
    "host:register": "bun scripts/register-host.ts",
    "simulate": "bun scripts/simulate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.3.14",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2"
  }
}
