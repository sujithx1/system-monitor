# /etc/system-monitor-agent/agent.env  (root:system-monitor-agent, mode 0640) – placeholders only.
# The agent token goes in /etc/system-monitor-agent/agent.token (root:root, 0600), NOT here.

MONITOR_URL=https://monitor.example.com
LOG_LEVEL=info

# Collection
AGENT_INTERVAL_SECONDS=30
AGENT_HEARTBEAT_SECONDS=30
# Comma-separated mount points, or "auto" for every real filesystem in /proc/mounts.
# Include the filesystem(s) holding PostgreSQL data and WAL.
AGENT_MOUNTS=/,/var/lib/postgresql

# PostgreSQL (read-only monitoring role; see postgres-monitoring-role.sql)
AGENT_PG_URL=postgres://system_monitor:CHANGE_ME@127.0.0.1:5432/appdb?sslmode=disable
# Additional databases/clusters (JSON array):
# AGENT_PG_TARGETS=[{"name":"replica","url":"postgres://system_monitor:CHANGE_ME@10.0.0.12:5432/appdb"}]
AGENT_PG_TIMEOUT_MS=5000
AGENT_PG_REPLICATION=false

# Application health endpoints (JSON array)
AGENT_HTTP_CHECKS=[{"name":"app","url":"http://127.0.0.1:8080/health","timeoutMs":5000}]

# Backup freshness: files your backup job touches after a verified successful run (JSON array)
# AGENT_BACKUP_MARKERS=[{"name":"nightly","path":"/var/lib/system-monitor-agent/backup-ok"}]

# Optional Docker container status – point at a read-only socket proxy, never docker.sock itself.
# AGENT_DOCKER_SOCKET=/run/docker-socket-proxy/docker.sock

# Private CA for the monitoring server certificate (only if not publicly trusted)
# AGENT_CA_FILE=/etc/system-monitor-agent/ca.pem
